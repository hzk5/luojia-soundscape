<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >


<mapper namespace="com.luojia.soundscape.account.mapper.UserAccountMapper">

	<resultMap id="userAccountMap" type="com.luojia.soundscape.model.account.UserAccount" autoMapping="true">
	</resultMap>

	<!-- 用于select查询公用抽取的列 -->
	<sql id="columns">
		id,user_id,total_amount,lock_amount,available_amount,total_income_amount,total_pay_amount,create_time,update_time,is_deleted
	</sql>

	<!--使用悲观锁防止账户余额超扣-->
    <select id="checkAmount" resultType="com.luojia.soundscape.model.account.UserAccount">
		SELECT * from user_account where user_id = #{vo.userId}
									 and available_amount >= #{vo.amount} and is_deleted = 0
			for update
	</select>

</mapper>

