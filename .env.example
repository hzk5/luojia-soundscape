# Copy to .env for local deployment. Never commit .env.
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USERNAME=root
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-me

REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=change-me
MONGODB_URI=mongodb://127.0.0.1:27017/luojia_soundscape
ELASTICSEARCH_URIS=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=

RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_USERNAME=luojia
RABBITMQ_PASSWORD=change-me
RABBITMQ_VHOST=/luojia-soundscape

NACOS_SERVER_ADDR=127.0.0.1:8848
NACOS_USERNAME=nacos
NACOS_PASSWORD=change-me
NACOS_AUTH_TOKEN=replace-with-a-base64-secret-of-at-least-32-bytes
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=change-me

MINIO_ENDPOINT=http://127.0.0.1:9000
MINIO_ACCESS_KEY=luojia
MINIO_SECRET_KEY=change-me
MINIO_BUCKET=luojia-soundscape

WECHAT_APP_ID=your-app-id
WECHAT_APP_SECRET=your-app-secret
WECHAT_PAY_MERCHANT_ID=your-merchant-id
WECHAT_PAY_SERIAL_NUMBER=your-merchant-serial-number
WECHAT_PAY_PRIVATE_KEY_PATH=/run/secrets/wechat-pay-private-key.pem
WECHAT_PAY_API_V3_KEY=your-api-v3-key
WECHAT_PAY_NOTIFY_URL=https://example.invalid/api/payment/wxPay/notify

TENCENT_VOD_APP_ID=
TENCENT_VOD_SECRET_ID=
TENCENT_VOD_SECRET_KEY=
TENCENT_VOD_REGION=ap-beijing

XXL_JOB_ADMIN_URL=http://127.0.0.1:8080/xxl-job-admin
XXL_JOB_ACCESS_TOKEN=change-me
SEATA_SERVER_ADDR=127.0.0.1:8091

GRAFANA_ADMIN_PASSWORD=change-me
LUOJIA_SOUNDSCAPE_SIGN_KEY=change-me
